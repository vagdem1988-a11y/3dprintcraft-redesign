# Cloudflare Pages header rules.
#
# This file previously held a copy of the old homepage HTML — the PowerShell
# mirror fetched the live site's URLs and saved them under these filenames.
# Pages treats _headers as configuration, so nothing in it applied and the
# redesign shipped with no security headers at all.
#
# The CSP can be this strict because the site loads nothing off-origin:
# no CDN, no analytics, no web fonts, no embeds. Verified by grepping every
# page for external src/href. Two deliberate allowances:
#   style-src 'unsafe-inline'  — the markup uses style="" attributes, and
#                                filaments.js writes swatch colours the same way
#   img-src data:              — inline SVG/data URIs
# Nothing needs script-src 'unsafe-inline': no page carries an inline <script>.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Assets are versioned in the markup with ?v=N, and the query string is part of
# the cache key, so a year is safe: changing a file changes its URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must never be held: it is what carries the new ?v=N to the browser.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
